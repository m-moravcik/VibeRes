    "'%@' is locked to current monitors": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je uzamčený na aktuální monitory"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist an die aktuellen Monitore gebunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is locked to current monitors"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está fijado a los monitores actuales"
          }
        },
        "fr": {
