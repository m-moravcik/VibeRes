          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profily sa nepodarilo uložiť."
          }
        }
      }
    },
    "problem.profilesUnreadable": {
      "comment": "profiles.json is too large, or does not decode",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
