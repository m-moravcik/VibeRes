        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für diese Sitzung und wird nach %lld Sekunden rückgängig gemacht, sofern du nicht bestätigst. Das Rückgängigmachen läuft von selbst und funktioniert daher auch bei unlesbarem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies for this session only and undoes it after %lld seconds unless you confirm. The undo runs on its own, so it works even when the screen is unreadable."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Solo vale para esta sesión y se revierte pasados %lld segundo si no lo confirmas. La reversión se hace sola, así que funciona incluso con la pantalla ilegible."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Solo vale para esta sesión y se revierte pasados %lld segundos si no lo confirmas. La reversión se hace sola, así que funciona incluso con la pantalla ilegible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Solo vale para esta sesión y se revierte pasados %lld segundos si no lo confirmas. La reversión se hace sola, así que funciona incluso con la pantalla ilegible."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Valable pour cette session uniquement ; annulé au bout de %lld seconde sans confirmation. L’annulation est automatique, même si l’écran est illisible."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Valable pour cette session uniquement ; annulé au bout de %lld secondes sans confirmation. L’annulation est automatique, même si l’écran est illisible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Valable pour cette session uniquement ; annulé au bout de %lld secondes sans confirmation. L’annulation est automatique, même si l’écran est illisible."
                }
              }
            }
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí len pre túto sesiu a po %lld sekundách sa vráti, ak ho nepotvrdíš. Vrátenie prebehne samo, takže funguje aj pri nečitateľnej obrazovke."
          }
        }
      }
    },
