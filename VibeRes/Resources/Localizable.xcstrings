    "Downloads updates in the background and offers to restart when one is ready. VibeRes never restarts on its own.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace stahuje na pozadí, a když je některá připravená, nabídne restart. VibeRes se nikdy nerestartuje sám."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Updates im Hintergrund und bietet einen Neustart an, sobald eines bereit ist. VibeRes startet nie von selbst neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads updates in the background and offers to restart when one is ready. VibeRes never restarts on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga las actualizaciones en segundo plano y ofrece reiniciar cuando hay una lista. VibeRes nunca se reinicia solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les mises à jour en arrière-plan et propose de redémarrer quand l’une est prête. VibeRes ne redémarre jamais de lui-même."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sťahuje aktualizácie na pozadí a keď je niektorá pripravená, ponúkne reštart. VibeRes sa nikdy nereštartuje sám."
          }
        }
      }
    },
