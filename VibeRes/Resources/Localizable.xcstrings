    "onboarding.welcome.body": {
      "comment": "Onboarding step 1 body",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínej rozlišení a obnovovací frekvenci každého připojeného monitoru přímo z řádku nabídek. Tři krátké kroky ti ukážou, jak na to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle Auflösung und Bildwiederholrate jedes angeschlossenen Bildschirms direkt aus der Menüleiste. Drei kurze Schritte zeigen dir, wie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch resolution and refresh rate on every connected display, straight from the menu bar. Three quick steps will show you how."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la resolución y la frecuencia de actualización de cada pantalla conectada directamente desde la barra de menús. Tres pasos rápidos te mostrarán cómo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez la résolution et la fréquence de rafraîchissement de chaque écran connecté directement depuis la barre des menus. Trois étapes rapides vous montrent comment faire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepínaj rozlíšenie a obnovovaciu frekvenciu pre každý pripojený monitor priamo z menubar. Tri krátke kroky ti ukážu, ako na to."
          }
        }
      }
    },
