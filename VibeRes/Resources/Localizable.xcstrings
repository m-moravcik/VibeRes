            "value": "Auf %3$@ ist kein Modus in der Nähe von %1$lld×%2$lld verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No mode close to %lld×%lld is available on %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún modo cercano a %1$lld×%2$lld en %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mode proche de %1$lld×%2$lld n’est disponible sur %3$@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %3$@ nie je dostupný žiadny režim blízky %1$lld×%2$lld."
          }
        }
      }
    },
    "Off by default. Logs display changes and their results to ~/Library/Logs/VibeRes, up to about 1 MB. Nothing is sent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Protokolliert Änderungen und Ergebnisse in ~/Library/Logs/VibeRes, maximal etwa 1 MB. Es wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Logs display changes and their results to ~/Library/Logs/VibeRes, up to about 1 MB. Nothing is sent."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvolene vypnuté. Zaznamenáva zmeny a výsledky do ~/Library/Logs/VibeRes, najviac okolo 1 MB. Nič sa neodosiela."
          }
        }
      }
    },
    "Only one display can be set to 'match any external monitor' — lock the others to a specific monitor instead.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen jeden displej může být nastaven na „odpovídat libovolnému externímu monitoru“. Ostatní uzamkni na konkrétní monitor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Display darf auf „zu jedem externen Monitor passen“ gesetzt sein – binde die anderen an einen bestimmten Monitor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one display can be set to 'match any external monitor' — lock the others to a specific monitor instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una pantalla puede configurarse como “coincidir con cualquier monitor externo”. Fija las demás a un monitor concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul écran peut être réglé sur « correspondre à n’importe quel moniteur externe ». Liez les autres à un moniteur précis."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Len jeden displej môže byť nastavený na „zodpovedať ľubovoľnému externému monitoru“ — ostatné uzamkni na konkrétny monitor."
          }
        }
      }
    },
    "Only one display per profile can match 'any external monitor'. Uncheck the other first.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V jednom profilu může „libovolnému externímu monitoru“ odpovídat jen jeden displej. Nejdřív zruš zaškrtnutí u toho druhého."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Profil darf nur ein Display zu „jedem externen Monitor“ passen. Nimm zuerst das andere heraus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one display per profile can match 'any external monitor'. Uncheck the other first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una pantalla por perfil puede coincidir con “cualquier monitor externo”. Desmarca primero la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul écran par profil peut correspondre à « n’importe quel moniteur externe ». Décochez d’abord l’autre."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V jednom profile môže „ľubovoľnému externému monitoru“ zodpovedať len jeden displej. Najprv odškrtni ten druhý."
          }
        }
      }
    },
    "Only one entry can match 'any external monitor' — remove or lock the duplicates first.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Libovolnému externímu monitoru“ může odpovídat jen jedna položka. Duplicity nejdřív odstraň nebo uzamkni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Eintrag darf zu „jedem externen Monitor“ passen – entferne oder binde die Duplikate zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one entry can match 'any external monitor' — remove or lock the duplicates first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un elemento puede coincidir con “cualquier monitor externo”. Elimina o fija primero los duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul élément peut correspondre à « n’importe quel moniteur externe ». Supprimez ou liez d’abord les doublons."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ľubovoľnému externému monitoru“ môže zodpovedať len jedna položka — duplikáty najprv odstráň alebo uzamkni."
          }
        }
      }
    },
