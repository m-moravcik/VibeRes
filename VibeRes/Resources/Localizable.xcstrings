    "Moves the menu bar and Dock to this display. The arrangement only shifts — relative positions are preserved.": {
      "comment": "Tooltip for the Make main display button",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesune řádek nabídek a Dock na tento displej. Uspořádání se jen posune, vzájemné polohy zůstanou zachované."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt Menüleiste und Dock auf diesen Bildschirm. Die Anordnung wird nur verschoben, die relativen Positionen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves the menu bar and Dock to this display. The arrangement only shifts — relative positions are preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
