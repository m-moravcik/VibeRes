    "Saved, but %@ report the same identity — this profile cannot tell them apart and will set both the same way.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo, ale %@ hlásí stejnou identitu. Tento profil je nedokáže rozlišit a nastaví obojí stejně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert, aber %@ melden dieselbe Kennung – dieses Profil kann sie nicht unterscheiden und stellt beide gleich ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved, but %@ report the same identity — this profile cannot tell them apart and will set both the same way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado, pero %@ comunican la misma identidad: este perfil no puede distinguirlas y configurará ambas igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré, mais %@ signalent la même identité : ce profil ne peut pas les distinguer et réglera les deux de la même façon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené, ale %@ hlásia rovnakú identitu — tento profil ich nedokáže rozlíšiť a nastaví oba rovnako."
          }
        }
      }
    },
