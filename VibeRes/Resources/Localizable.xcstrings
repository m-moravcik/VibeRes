            "state": "translated",
            "value": "Uložené profily sa nepodarilo načítať."
          }
        }
      }
    },
    "problem.switch.busy": {
      "comment": "CoreGraphics returned cannotComplete for a display reconfiguration",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Änderung abgelehnt — der Bildschirm ist möglicherweise beschäftigt, bitte erneut versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused the change — the display may be busy, try again"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zmenu odmietol — displej môže byť zaneprázdnený, skúste to znova"
          }
        }
      }
    },
    "problem.switch.connectionDropped": {
      "comment": "The display went away mid-reconfiguration",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmverbindung wurde beim Wechsel des Modus unterbrochen"
