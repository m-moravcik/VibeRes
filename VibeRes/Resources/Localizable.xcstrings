    "Switches the chosen display to the requested resolution. Picks the closest matching mode if the exact size isn't available.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepne vybraný displej na požadované rozlišení. Pokud přesná velikost není dostupná, vybere nejbližší odpovídající režim."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet das gewählte Display auf die angeforderte Auflösung. Wählt den nächstpassenden Modus, wenn die exakte Größe nicht verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches the chosen display to the requested resolution. Picks the closest matching mode if the exact size isn't available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la pantalla elegida a la resolución solicitada. Si el tamaño exacto no está disponible, elige el modo más cercano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe l’écran choisi à la résolution demandée. Choisit le mode le plus proche si la taille exacte n’est pas disponible."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepne vybraný displej na požadované rozlíšenie. Ak presná veľkosť nie je dostupná, vyberie najbližší zodpovedajúci režim."
          }
        }
      }
    },
    "That display is no longer connected.": {
      "extractionState": "manual",
