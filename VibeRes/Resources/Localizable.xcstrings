    "The saved resolutions for this profile are gone for good. Your displays are not touched.": {
      "comment": "Body of the inline delete confirmation",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená rozlišení tohoto profilu se nenávratně ztratí. Displejů se to nedotkne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Auflösungen dieses Profils sind unwiderruflich weg. Ihre Bildschirme bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved resolutions for this profile are gone for good. Your displays are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las resoluciones guardadas de este perfil se perderán para siempre. Tus pantallas no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résolutions enregistrées de ce profil seront définitivement perdues. Vos écrans ne sont pas modifiés."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené rozlíšenia tohto profilu sa nenávratne stratia. Displejov sa to nedotkne."
          }
        }
      }
    },
