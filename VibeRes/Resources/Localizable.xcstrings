    "Shows a screenshot of your desktop scaled into the proposed mode. Asks for Screen Recording the first time.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí snímek plochy ve zvoleném režimu. Při prvním použití požádá o Nahrávání obrazovky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Screenshot deines Schreibtischs, skaliert in den vorgeschlagenen Modus. Fragt beim ersten Mal nach Bildschirmaufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a screenshot of your desktop scaled into the proposed mode. Asks for Screen Recording the first time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una captura de tu escritorio escalada al modo propuesto. La primera vez pide el permiso de Grabación de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une capture de votre bureau mise à l’échelle dans le mode proposé. Demande l’enregistrement de l’écran la première fois."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí snímku plochy zmenšenú do navrhovaného režimu. Pri prvom použití si vyžiada Screen Recording."
          }
        }
      }
    },
