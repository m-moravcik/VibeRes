      }
    },
    "problem.mirroredArrangement": {
      "comment": "Shown when a main-display change is refused because mirroring is on",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Displeje jsou zrcadlené, hlavní displej zůstal beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirme werden gespiegelt — der Hauptbildschirm blieb unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays are mirrored — the main display was left unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pantallas están en espejo: la pantalla principal no se ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écrans sont en miroir : l’écran principal n’a pas été modifié."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Displeje sú zrkadlené — hlavný displej zostal nezmenený."
          }
        }
      }
    },
    "problem.originCoverage": {
      "comment": "An origin plan no longer covers exactly the active displays, so it is refused",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestava displejů se během použití změnila, uspořádání zůstalo beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmkonfiguration hat sich während des Anwendens geändert — die Anordnung blieb unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display setup changed while applying — the arrangement was left unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de pantallas cambió durante la aplicación: la disposición no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration d’écrans a changé pendant l’application : la disposition n’a pas été modifiée."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostava displejov sa počas aplikovania zmenila — rozloženie zostalo nezmenené."
          }
        }
      }
    },
    "problem.previousMainNotRestored": {
      "comment": "Revert put the modes back but could not move the menu bar back",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí hlavní displej se nepodařilo obnovit, macOS upravil uspořádání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Hauptbildschirm konnte nicht wiederhergestellt werden — macOS hat die Anordnung angepasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous main display could not be restored — macOS adjusted the arrangement."
          }
