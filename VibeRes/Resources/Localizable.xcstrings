      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní displej je nastaven, ale macOS upravil uspořádání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
