    "'%@' is locked to current monitors": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist an die aktuellen Monitore gebunden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is locked to current monitors"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je uzamknutý na aktuálne monitory"
          }
        }
      }
    },
    "'%@' now matches any external monitor": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ passt jetzt zu jedem externen Monitor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' now matches any external monitor"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ teraz zodpovedá ľubovoľnému externému monitoru"
          }
        }
      }
    },
    "'Scaled' uses HiDPI rendering so text stays sharp on Retina (the default for built-in displays). 'Native' is 1:1 pixel mapping — typical for non-Retina external monitors.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Skaliert“ nutzt HiDPI-Rendering, damit Text auf Retina scharf bleibt (Standard für eingebaute Displays). „Nativ“ ist 1:1-Pixelabbildung – typisch für externe Monitore ohne Retina."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'Scaled' uses HiDPI rendering so text stays sharp on Retina (the default for built-in displays). 'Native' is 1:1 pixel mapping — typical for non-Retina external monitors."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Škálované“ používa HiDPI vykresľovanie, takže text zostane ostrý na Retine (predvolené pre vstavané displeje). „Natívne“ je mapovanie 1:1 — typické pre externé monitory bez Retiny."
          }
        }
      }
    },
    "A profile named '%@' already exists. Pick another name.": {
      "comment": "Shown when a save or rename would duplicate an existing profile name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil mit dem Namen „%@“ existiert bereits. Bitte einen anderen Namen wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile named '%@' already exists. Pick another name."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil s názvom „%@“ už existuje. Zvoľte iný názov."
          }
        }
      }
    },
    "About VibeRes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über VibeRes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About VibeRes"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikácii VibeRes"
          }
        }
      }
    },
    "Applied '%@' for the new display setup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ für die neue Displaykonfiguration angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied '%@' for the new display setup."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použitý profil „%@“ pre nové rozloženie displejov."
          }
        }
      }
    },
    "Applied silently when a monitor is plugged in or unplugged. Changing only a resolution never triggers it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird still angewendet, wenn ein Monitor angeschlossen oder getrennt wird. Eine reine Auflösungsänderung löst das nie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied silently when a monitor is plugged in or unplugged. Changing only a resolution never triggers it."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije sa potichu pri pripojení alebo odpojení monitora. Samotná zmena rozlíšenia to nikdy nespustí."
          }
        }
      }
    },
    "Applies a new resolution for this session only and undoes it after %lld seconds unless you confirm. Useful if a mode has ever left your screen unreadable — the undo happens on its own, so it works even when you cannot see the button.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet eine neue Auflösung nur für diese Sitzung an und macht sie nach %lld Sekunden rückgängig, sofern du nicht bestätigst. Nützlich, wenn ein Modus deinen Bildschirm schon einmal unlesbar gemacht hat – das Rückgängigmachen passiert von selbst und funktioniert daher auch, wenn du den Knopf nicht sehen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies a new resolution for this session only and undoes it after %lld seconds unless you confirm. Useful if a mode has ever left your screen unreadable — the undo happens on its own, so it works even when you cannot see the button."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije nové rozlíšenie len pre túto sesiu a po %lld sekundách ho vráti, ak ho nepotvrdíš. Užitočné, ak ti niektorý režim už niekedy nechal nečitateľnú obrazovku — vrátenie prebehne samo, takže funguje aj vtedy, keď tlačidlo nevidíš."
          }
        }
      }
    },
    "Applies for this session only and undoes it after %lld seconds unless you confirm. The undo runs on its own, so it works even when the screen is unreadable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für diese Sitzung und wird nach %lld Sekunden rückgängig gemacht, sofern du nicht bestätigst. Das Rückgängigmachen läuft von selbst und funktioniert daher auch bei unlesbarem Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies for this session only and undoes it after %lld seconds unless you confirm. The undo runs on its own, so it works even when the screen is unreadable."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí len pre túto sesiu a po %lld sekundách sa vráti, ak ho nepotvrdíš. Vrátenie prebehne samo, takže funguje aj pri nečitateľnej obrazovke."
          }
        }
      }
    },
    "Apply '%@'?": {
      "extractionState": "manual",
