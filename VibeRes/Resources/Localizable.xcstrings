    "Applied '%@' for the new display setup.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použit profil „%@“ pro nové uspořádání displejů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ für die neue Displaykonfiguration angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied '%@' for the new display setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplicó “%@” a la nueva configuración de pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » appliqué à la nouvelle configuration d’écrans."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použitý profil „%@“ pre nové rozloženie displejov."
          }
        }
      }
    },
    "Applied silently when a monitor is plugged in or unplugged. Changing only a resolution never triggers it.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije se potichu při připojení nebo odpojení monitoru. Samotná změna rozlišení to nikdy nespustí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird still angewendet, wenn ein Monitor angeschlossen oder getrennt wird. Eine reine Auflösungsänderung löst das nie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied silently when a monitor is plugged in or unplugged. Changing only a resolution never triggers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica en silencio al conectar o desconectar un monitor. Cambiar solo la resolución nunca lo activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué en silence lorsqu’un moniteur est branché ou débranché. Un simple changement de résolution ne le déclenche jamais."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije sa potichu pri pripojení alebo odpojení monitora. Samotná zmena rozlíšenia to nikdy nespustí."
          }
        }
      }
    },
    "Applies a new resolution for this session only and undoes it after %lld seconds unless you confirm. Useful if a mode has ever left your screen unreadable — the undo happens on its own, so it works even when you cannot see the button.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Použije nové rozlišení jen pro tuto relaci a po %lld sekundě ho vrátí, pokud ho nepotvrdíš. Užitečné, pokud ti nějaký režim někdy nechal nečitelnou obrazovku. Vrácení proběhne samo, takže funguje i tehdy, když tlačítko nevidíš."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Použije nové rozlišení jen pro tuto relaci a po %lld sekundách ho vrátí, pokud ho nepotvrdíš. Užitečné, pokud ti nějaký režim někdy nechal nečitelnou obrazovku. Vrácení proběhne samo, takže funguje i tehdy, když tlačítko nevidíš."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Použije nové rozlišení jen pro tuto relaci a po %lld sekundy ho vrátí, pokud ho nepotvrdíš. Užitečné, pokud ti nějaký režim někdy nechal nečitelnou obrazovku. Vrácení proběhne samo, takže funguje i tehdy, když tlačítko nevidíš."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Použije nové rozlišení jen pro tuto relaci a po %lld sekundách ho vrátí, pokud ho nepotvrdíš. Užitečné, pokud ti nějaký režim někdy nechal nečitelnou obrazovku. Vrácení proběhne samo, takže funguje i tehdy, když tlačítko nevidíš."
                }
              }
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet eine neue Auflösung nur für diese Sitzung an und macht sie nach %lld Sekunden rückgängig, sofern du nicht bestätigst. Nützlich, wenn ein Modus deinen Bildschirm schon einmal unlesbar gemacht hat – das Rückgängigmachen passiert von selbst und funktioniert daher auch, wenn du den Knopf nicht sehen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies a new resolution for this session only and undoes it after %lld seconds unless you confirm. Useful if a mode has ever left your screen unreadable — the undo happens on its own, so it works even when you cannot see the button."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aplica una nueva resolución solo en esta sesión y la revierte pasados %lld segundo si no la confirmas. Es útil si algún modo ha dejado alguna vez tu pantalla ilegible: la reversión se hace sola, así que funciona incluso cuando no ves el botón."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aplica una nueva resolución solo en esta sesión y la revierte pasados %lld segundos si no la confirmas. Es útil si algún modo ha dejado alguna vez tu pantalla ilegible: la reversión se hace sola, así que funciona incluso cuando no ves el botón."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Aplica una nueva resolución solo en esta sesión y la revierte pasados %lld segundos si no la confirmas. Es útil si algún modo ha dejado alguna vez tu pantalla ilegible: la reversión se hace sola, así que funciona incluso cuando no ves el botón."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Applique une nouvelle résolution pour cette session uniquement et l’annule au bout de %lld seconde si vous ne confirmez pas. Utile si un mode a déjà rendu votre écran illisible : l’annulation est automatique, elle fonctionne donc même quand vous ne voyez pas le bouton."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Applique une nouvelle résolution pour cette session uniquement et l’annule au bout de %lld secondes si vous ne confirmez pas. Utile si un mode a déjà rendu votre écran illisible : l’annulation est automatique, elle fonctionne donc même quand vous ne voyez pas le bouton."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Applique une nouvelle résolution pour cette session uniquement et l’annule au bout de %lld secondes si vous ne confirmez pas. Utile si un mode a déjà rendu votre écran illisible : l’annulation est automatique, elle fonctionne donc même quand vous ne voyez pas le bouton."
                }
              }
            }
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije nové rozlíšenie len pre túto sesiu a po %lld sekundách ho vráti, ak ho nepotvrdíš. Užitočné, ak ti niektorý režim už niekedy nechal nečitateľnú obrazovku — vrátenie prebehne samo, takže funguje aj vtedy, keď tlačidlo nevidíš."
          }
        }
      }
    },
    "Applies for this session only and undoes it after %lld seconds unless you confirm. The undo runs on its own, so it works even when the screen is unreadable.": {
      "extractionState": "manual",
      "localizations": {
