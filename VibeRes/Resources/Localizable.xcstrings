    "onboarding.profiles.body": {
      "comment": "Onboarding step 2 body",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulož si celé nastavení více displejů jako „Práce“, „Prezentace“ nebo „Cesty“. Jedno kliknutí všechno zase použije. VibeRes umí po připojení monitoru i sám vybrat nejvhodnější profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere dein gesamtes Mehrbildschirm-Setup als „Arbeit“, „Präsentation“ oder „Reise“. Ein Klick wendet alles wieder an. VibeRes kann das beste Profil auch automatisch nach dem Anschließen eines Monitors auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your whole multi-display setup as “Work”, “Presentation”, or “Travel”. One click applies everything again. VibeRes can also pick the best profile automatically after a monitor is plugged in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda toda tu configuración de varias pantallas como “Trabajo”, “Presentación” o “Viaje”. Un clic lo aplica todo de nuevo. VibeRes también puede elegir automáticamente el mejor perfil al conectar un monitor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez toute votre configuration multi-écran sous « Travail », « Présentation » ou « Voyage ». Un clic suffit pour tout réappliquer. VibeRes peut aussi choisir automatiquement le meilleur profil après le branchement d’un moniteur."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulož si celé multi-display nastavenie ako „Práca“, „Prezentácia“ alebo „Cesty“. Jeden klik všetko opäť aplikuje. VibeRes vie po pripojení monitora aj sám vybrať najvhodnejší profil."
          }
        }
      }
    },
    "onboarding.profiles.title": {
      "comment": "Onboarding step 2 title",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profily šetří čas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile sparen Zeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles save you time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles te ahorran tiempo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils font gagner du temps"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profily ti šetria čas"
          }
        }
      }
    },
    "onboarding.simple.body": {
      "comment": "Onboarding step 3 body",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V jednoduchém režimu stačí jedno kliknutí na rozlišení a použije se s nejvyšší obnovovací frekvencí. Pokročilí ho mohou vypnout v Nastavení (⌘,), kde najdou i živý náhled a předvolby aktualizací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Einfachen Modus genügt ein Klick auf eine Auflösung – die höchste verfügbare Bildwiederholrate wird automatisch gewählt. Profis können das in den Einstellungen (⌘,) ausschalten und dort auch die Live-Vorschau und automatische Updates regeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Simple Mode one click on a resolution applies it at the highest refresh rate. Power users can turn it off in Settings (⌘,), where Live Preview and update preferences live too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo sencillo, un clic en una resolución la aplica con la frecuencia de actualización más alta. Los usuarios avanzados pueden desactivarlo en Ajustes (⌘,), donde también están la vista previa en vivo y las preferencias de actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode simple, un clic sur une résolution l’applique avec la fréquence de rafraîchissement la plus élevée. Les utilisateurs avancés peuvent le désactiver dans Réglages (⌘,), où se trouvent aussi l’aperçu en direct et les préférences de mise à jour."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V Jednoduchom režime stačí jeden klik na rozlíšenie — použije sa s najvyššou Hz. Pokročilí ho môžu vypnúť v Nastaveniach (⌘,), kde sú aj možnosti živého náhľadu a aktualizácií."
          }
        }
      }
    },
    "onboarding.simple.title": {
      "comment": "Onboarding step 3 title",
      "extractionState": "manual",
      "localizations": {
