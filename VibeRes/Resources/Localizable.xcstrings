    "problem.switch.busy": {
      "comment": "CoreGraphics returned cannotComplete for a display reconfiguration",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS změnu odmítl, displej může být zaneprázdněný. Zkus to znovu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Änderung abgelehnt — der Bildschirm ist möglicherweise beschäftigt, bitte erneut versuchen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS refused the change — the display may be busy, try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS rechazó el cambio: puede que la pantalla esté ocupada. Inténtalo de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a refusé le changement : l’écran est peut-être occupé. Réessayez"
