      }
    },
    "Updated '%@' with current setup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "„%@“ mit aktueller Konfiguration aktualisiert" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Updated '%@' with current setup" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "„%@“ aktualizovaný podľa aktuálneho stavu" } }
      }
    },
    "VibeRes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "VibeRes" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "VibeRes" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "VibeRes" } }
      }
    },
    "VibeRes also checks once a day in the background. Brew users can run `brew upgrade --cask m-moravcik/viberes/viberes-app` to install the new build." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "VibeRes prüft außerdem einmal täglich im Hintergrund. Brew-Nutzer können `brew upgrade --cask m-moravcik/viberes/viberes-app` ausführen, um den neuen Build zu installieren." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "VibeRes also checks once a day in the background. Brew users can run `brew upgrade --cask m-moravcik/viberes/viberes-app` to install the new build." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "VibeRes navyše kontroluje raz denne na pozadí. Používatelia brew môžu nový build nainštalovať príkazom `brew upgrade --cask m-moravcik/viberes/viberes-app`." } }
      }
    },
    "When both HiDPI and native modes exist for the size, prefer the HiDPI variant." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wenn es für die Größe HiDPI- und native Modi gibt, die HiDPI-Variante bevorzugen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When both HiDPI and native modes exist for the size, prefer the HiDPI variant." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Keď pre danú veľkosť existujú HiDPI aj natívne režimy, preferovať HiDPI variantu." } }
      }
    },
    "Width" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Breite" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Width" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Šírka" } }
      }
    },
    "Width in points (logical pixels), e.g. 1800" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Breite in Punkten (logische Pixel), z. B. 1800" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Width in points (logical pixels), e.g. 1800" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Šírka v bodoch (logické pixely), napr. 1800" } }
      }
    },
    "not connected" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "nicht verbunden" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "not connected" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "nie je pripojený" } }
      }
    },
    "Saved, but %@ report the same identity — this profile cannot tell them apart and will set both the same way." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gespeichert, aber %@ melden dieselbe Kennung – dieses Profil kann sie nicht unterscheiden und stellt beide gleich ein." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved, but %@ report the same identity — this profile cannot tell them apart and will set both the same way." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uložené, ale %@ hlásia rovnakú identitu — tento profil ich nedokáže rozlíšiť a nastaví oba rovnako." } }
      }
    },
    "Keep this resolution? Reverting in %llds" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Auflösung behalten? Rückgängig in %lld s" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep this resolution? Reverting in %llds" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ponechať toto rozlíšenie? Vrátenie za %lld s" } }
      }
    },
    "Keep" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Behalten" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Ponechať" } }
      }
    },
    "Confirm resolution changes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auflösungsänderungen bestätigen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm resolution changes" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Potvrdzovať zmeny rozlíšenia" } }
      }
    },
    "Applies a new resolution for this session only and undoes it after %lld seconds unless you confirm. Useful if a mode has ever left your screen unreadable — the undo happens on its own, so it works even when you cannot see the button." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wendet eine neue Auflösung nur für diese Sitzung an und macht sie nach %lld Sekunden rückgängig, sofern du nicht bestätigst. Nützlich, wenn ein Modus deinen Bildschirm schon einmal unlesbar gemacht hat – das Rückgängigmachen passiert von selbst und funktioniert daher auch, wenn du den Knopf nicht sehen kannst." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Applies a new resolution for this session only and undoes it after %lld seconds unless you confirm. Useful if a mode has ever left your screen unreadable — the undo happens on its own, so it works even when you cannot see the button." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Použije nové rozlíšenie len pre túto sesiu a po %lld sekundách ho vráti, ak ho nepotvrdíš. Užitočné, ak ti niektorý režim už niekedy nechal nečitateľnú obrazovku — vrátenie prebehne samo, takže funguje aj vtedy, keď tlačidlo nevidíš." } }
      }
    },
    "updates.unavailableInThisBuild" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Updates in dieser Version nicht verfügbar." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates unavailable in this build." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Aktualizácie nie sú v tomto builde dostupné." } }
      }
    },
    "updates.managedByHomebrew" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Updates werden von Homebrew verwaltet. Führe aus: brew upgrade --cask m-moravcik/viberes/viberes-app" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Updates managed by Homebrew. Run: brew upgrade --cask m-moravcik/viberes/viberes-app" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Aktualizácie spravuje Homebrew. Spusť: brew upgrade --cask m-moravcik/viberes/viberes-app" } }
      }
    },
    "Update ready" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Update bereit" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update ready" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Aktualizácia je pripravená" } }
      }
    },
    "Click to restart into the new version" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Klicken, um in die neue Version neu zu starten" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Click to restart into the new version" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Kliknutím reštartuješ do novej verzie" } }
      }
    },
    "Installs the downloaded update and relaunches VibeRes" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Installiert das geladene Update und startet VibeRes neu" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Installs the downloaded update and relaunches VibeRes" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Nainštaluje stiahnutú aktualizáciu a reštartuje VibeRes" } }
      }
    },
    "Check for updates automatically" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch nach Updates suchen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for updates automatically" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Automaticky kontrolovať aktualizácie" } }
      }
    },
    "Downloads updates in the background and offers to restart when one is ready. VibeRes never restarts on its own." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Lädt Updates im Hintergrund und bietet einen Neustart an, sobald eines bereit ist. VibeRes startet nie von selbst neu." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloads updates in the background and offers to restart when one is ready. VibeRes never restarts on its own." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Sťahuje aktualizácie na pozadí a keď je niektorá pripravená, ponúkne reštart. VibeRes sa nikdy nereštartuje sám." } }
      }
    },
    "Check for Updates…" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach Updates suchen…" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check for Updates…" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Skontrolovať aktualizácie…" } }
      }
    },
    "Saved, but %lld selected display(s) were disconnected before saving and are not in the profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gespeichert, aber %lld ausgewählte Displays wurden vor dem Speichern getrennt und sind nicht im Profil." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved, but %lld selected display(s) were disconnected before saving and are not in the profile." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Uložené, ale %lld vybraných displejov bolo pred uložením odpojených a v profile nie sú." } }
      }
    },
    "Width must be between 1 and 16384 points." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Breite muss zwischen 1 und 16384 Punkten liegen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Width must be between 1 and 16384 points." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Šírka musí byť medzi 1 a 16384 bodmi." } }
      }
    },
    "Height must be between 1 and 16384 points." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Höhe muss zwischen 1 und 16384 Punkten liegen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Height must be between 1 and 16384 points." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Výška musí byť medzi 1 a 16384 bodmi." } }
      }
    },
    "Refresh rate must be between 1 and 1000 Hz." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Bildwiederholrate muss zwischen 1 und 1000 Hz liegen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh rate must be between 1 and 1000 Hz." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Obnovovacia frekvencia musí byť medzi 1 a 1000 Hz." } }
      }
    },
    "Applied silently when a monitor is plugged in or unplugged. Changing only a resolution never triggers it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird still angewendet, wenn ein Monitor angeschlossen oder getrennt wird. Eine reine Auflösungsänderung löst das nie aus." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Applied silently when a monitor is plugged in or unplugged. Changing only a resolution never triggers it." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Použije sa potichu pri pripojení alebo odpojení monitora. Samotná zmena rozlíšenia to nikdy nespustí." } }
      }
    },
    "Applies for this session only and undoes it after %lld seconds unless you confirm. The undo runs on its own, so it works even when the screen is unreadable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gilt nur für diese Sitzung und wird nach %lld Sekunden rückgängig gemacht, sofern du nicht bestätigst. Das Rückgängigmachen läuft von selbst und funktioniert daher auch bei unlesbarem Bildschirm." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Applies for this session only and undoes it after %lld seconds unless you confirm. The undo runs on its own, so it works even when the screen is unreadable." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Platí len pre túto sesiu a po %lld sekundách sa vráti, ak ho nepotvrdíš. Vrátenie prebehne samo, takže funguje aj pri nečitateľnej obrazovke." } }
      }
    },
    "Hides the refresh-rate chips; a click applies the highest rate available for that size." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Blendet die Bildwiederholraten aus; ein Klick wendet die höchste für diese Größe verfügbare Rate an." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hides the refresh-rate chips; a click applies the highest rate available for that size." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Skryje čipy s obnovovacou frekvenciou; klik použije najvyššiu dostupnú pre danú veľkosť." } }
      }
    },
    "Shows a screenshot of your desktop scaled into the proposed mode. Asks for Screen Recording the first time." : {
      "extractionState" : "manual",
      "localizations" : {
