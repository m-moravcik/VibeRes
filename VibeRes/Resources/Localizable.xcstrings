            "state": "translated",
            "value": "„%@“ je uzamknutý na aktuálne monitory"
          }
        }
      }
    },
    "'%@' now matches any external monitor": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ teď odpovídá libovolnému externímu monitoru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ passt jetzt zu jedem externen Monitor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' now matches any external monitor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ahora coincide con cualquier monitor externo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » correspond désormais à n’importe quel moniteur externe"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ teraz zodpovedá ľubovoľnému externému monitoru"
          }
        }
      }
    },
    "'Scaled' uses HiDPI rendering so text stays sharp on Retina (the default for built-in displays). 'Native' is 1:1 pixel mapping — typical for non-Retina external monitors.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Škálované“ používá vykreslování HiDPI, takže text zůstane na Retině ostrý (výchozí pro vestavěné displeje). „Nativní“ je mapování pixelů 1:1, typické pro externí monitory bez Retiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Skaliert“ nutzt HiDPI-Rendering, damit Text auf Retina scharf bleibt (Standard für eingebaute Displays). „Nativ“ ist 1:1-Pixelabbildung – typisch für externe Monitore ohne Retina."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'Scaled' uses HiDPI rendering so text stays sharp on Retina (the default for built-in displays). 'Native' is 1:1 pixel mapping — typical for non-Retina external monitors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Escalada” usa renderizado HiDPI para que el texto se vea nítido en Retina (lo habitual en las pantallas integradas). “Nativa” es una correspondencia de píxeles 1:1, típica de los monitores externos sin Retina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Mis à l’échelle » utilise le rendu HiDPI pour que le texte reste net sur Retina (par défaut pour les écrans intégrés). « Natif » est un mappage 1:1 des pixels, typique des moniteurs externes non Retina."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Škálované“ používa HiDPI vykresľovanie, takže text zostane ostrý na Retine (predvolené pre vstavané displeje). „Natívne“ je mapovanie 1:1 — typické pre externé monitory bez Retiny."
          }
        }
      }
    },
    "A profile named '%@' already exists. Pick another name.": {
      "comment": "Shown when a save or rename would duplicate an existing profile name",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil s názvem „%@“ už existuje. Zvol jiný název."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil mit dem Namen „%@“ existiert bereits. Bitte einen anderen Namen wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile named '%@' already exists. Pick another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un perfil llamado “%@”. Elige otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un profil nommé « %@ » existe déjà. Choisissez un autre nom."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil s názvom „%@“ už existuje. Zvoľte iný názov."
          }
        }
      }
    },
