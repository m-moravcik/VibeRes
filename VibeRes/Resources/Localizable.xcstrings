      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Profile speichern Auflösung und Bildwiederholrate jedes gewählten Displays, damit du sie mit einem Klick anwenden kannst. Externe können an einen bestimmten Monitor gebunden oder auf „beliebiger externer“ gesetzt werden (praktisch für Präsentationen)." } },
