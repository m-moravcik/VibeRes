    "Size" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Größe" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Size" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Veľkosť" } }
      }
    },
    "Switches the chosen display to the requested resolution. Picks the closest matching mode if the exact size isn't available." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Schaltet das gewählte Display auf die angeforderte Auflösung. Wählt den nächstpassenden Modus, wenn die exakte Größe nicht verfügbar ist." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Switches the chosen display to the requested resolution. Picks the closest matching mode if the exact size isn't available." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Prepne vybraný displej na požadované rozlíšenie. Ak presná veľkosť nie je dostupná, vyberie najbližší zodpovedajúci režim." } }
      }
    },
    "That display is no longer connected." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Display ist nicht mehr angeschlossen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "That display is no longer connected." } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Tento displej už nie je pripojený." } }
      }
    },
    "Update available — %@ on GitHub" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Update verfügbar – %@ auf GitHub" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update available — %@ on GitHub" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Dostupná aktualizácia — %@ na GitHube" } }
      }
    },
    "Update with current setup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mit aktueller Konfiguration aktualisieren" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update with current setup" } },
        "sk" : { "stringUnit" : { "state" : "translated", "value" : "Aktualizovať podľa aktuálneho stavu" } }
