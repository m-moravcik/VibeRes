        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display connection dropped while changing the mode"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počas zmeny režimu sa prerušilo spojenie s displejom"
          }
        }
      }
    },
    "problem.switch.generic": {
      "comment": "Fallback for any other CoreGraphics error code",
