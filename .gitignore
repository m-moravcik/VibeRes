# Xcode
build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Coverage profile dumps. Release builds no longer emit these (see the
# ENABLE_CODE_COVERAGE note in project.yml), but `xcodebuild test` still does.
*.profraw
*.profdata

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/

# Notarization / signing artifacts
*.app.zip
*.dmg
notarization-*.json
artifacts/

# Signing secrets — these must never enter the repo. The Developer ID private
# key and the App Store Connect API key are the only things standing between a
# leak and someone shipping malware signed as us.
*.p12
*.pfx
*.p8
AuthKey_*.p8
*.cer
*.certSigningRequest

# Local release configuration: points at the App Store Connect API key and
# holds the key/issuer IDs. Not secret by itself, but machine-specific.
.release.env

# XcodeGen output — regenerate with `xcodegen generate`, project.yml is the source of truth
*.xcodeproj/

# Icon render scratch — actual icons live in Assets.xcassets
icon-build/

# Localisation coverage check output
build-localisation/

# Sparkle private signing key — never in the repo
sparkle_ed25519.key

# Internal audit reports — findings are worked off in the code and the
# changelog, not published as a standing list of this repo's weak points.
docs/*audit*.md

# Python bytecode from scripts/
__pycache__/
